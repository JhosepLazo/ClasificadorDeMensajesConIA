# Entorno virtual local de Python.
.venv/

# Archivos temporales generados por Python.
__pycache__/
*.py[cod]
*$py.class

# Configuracion local de notebooks.
.ipynb_checkpoints/

# Cache generado por herramientas de analisis/tipado.
.mypy_cache/

# Archivos de sistema operativo.
.DS_Store
Thumbs.db

# Archivos temporales de editores.
.vscode/
.idea/

# Logs y salidas temporales.
*.log
tmp/
temp/
